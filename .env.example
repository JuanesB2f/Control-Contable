# Copia este archivo como .env.local y completa los valores.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública de la app (enlaces de invitación y correos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (opcional). Sin estas variables las invitaciones se comparten por enlace.
RESEND_API_KEY=
EMAIL_FROM="VitaEsme <hola@tudominio.com>"

# Sentry (opcional)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (opcional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
